# BYBLOS Test Environment Configuration Template — Standardized
# Copy this to server/.env.test for local integration & E2E tests

NODE_ENV=test
PORT=3003
APP_NAME=Byblos-Test

# ─── Test Database ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3001
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=byblos_test
DB_SSL=false

# ─── Security & Auth (Test Secrets) ───────────────────────────────────────────
JWT_SECRET=test_jwt_secret_value_must_be_at_least_32_characters_long
JWT_REFRESH_SECRET=test_jwt_refresh_secret_value_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d

# ─── Infrastructure / URLs ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3003
ALLOWED_ORIGINS=http://localhost:3000

# ─── Payment Gateway (Mock Placeholders for Testing) ──────────────────────────
PAYMENT_PROVIDER=paystack
PAYOUT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_mock_secret_key_for_testing
PAYSTACK_PUBLIC_KEY=pk_test_mock_public_key_for_testing
PAYSTACK_BASE_URL=http://localhost:3003/mock-paystack

# ─── Email & Test User Credentials ───────────────────────────────────────────
EMAIL_FROM_EMAIL=no-reply@byblos.test
EMAIL_FROM_NAME=Byblos Test
ADMIN_EMAIL=admin@byblos.test
ADMIN_PASSWORD=TestAdminPassword123!
MARKETING_EMAIL=marketing@byblos.test
MARKETING_PASSWORD=TestMarketingPassword123!
MZIGO_EMAIL=mzigo@byblos.test
MZIGO_PASSWORD=TestMzigoPassword123!
