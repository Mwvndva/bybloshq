# Copy to .env.sandbox.test (gitignored) and fill in your OWN Paystack
# TEST-MODE keys from https://dashboard.paystack.com (Settings > API Keys &
# Webhooks, Test Mode). Used ONLY by server/scripts/manual-paystack-sandbox-*.mjs
# for a one-off live verification against Paystack's real sandbox — never by
# the automated test suite, which stays on .env.test's mock URL.
#
# To actually receive Paystack's webhook you also need a public tunnel
# (e.g. `ngrok http 3003`) and to register <tunnel-url>/api/webhooks/paystack
# as the webhook URL in your Paystack dashboard's Test Mode settings for the
# duration of the check.
NODE_ENV=test
PORT=3003
APP_NAME=Byblos-Test
DB_HOST=localhost
DB_PORT=3001
DB_USER=postgres
DB_PASSWORD=nurubot
DB_NAME=byblos_test
DB_SSL=false
JWT_SECRET=replace_with_any_32plus_char_value_for_local_use_only
JWT_REFRESH_SECRET=replace_with_any_32plus_char_value_for_local_use_only
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3003
ALLOWED_ORIGINS=http://localhost:3000
PAYMENT_PROVIDER=paystack
PAYOUT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_your_real_test_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_real_test_public_key_here
PAYSTACK_BASE_URL=https://api.paystack.co
EMAIL_FROM_EMAIL=no-reply@byblos.test
EMAIL_FROM_NAME=Byblos Test
