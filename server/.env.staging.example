# =============================================================================
# Byblos backend — staging environment template
# =============================================================================
# Copy to `.env` on the staging host (that filename is what docker-compose's
# `env_file: .env` loads, and it is gitignored). This template is the canonical
# manifest of every variable the backend actually needs; it was derived from
# server/src/shared/config/validateEnv.js (the boot-time validator that
# process.exit(1)s on anything missing) plus the docker-compose.yml service
# definitions, not guessed.
#
# STAGING PRINCIPLE: identical SHAPE to production, safe VALUES. Same variables,
# same provider wiring, but a separate database, Paystack TEST-mode keys, a
# staging domain, and throwaway secrets — so a deploy here is a true dry run
# without touching real money or real customer data.
#
# Legend:
#   [REQUIRED]      validateEnv exits the process if unset (ALL environments)
#   [REQUIRED-PROD] validateEnv exits only when NODE_ENV=production; warns otherwise
#   [OPTIONAL]      used if present; a sensible default or graceful fallback exists
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=production                 # [REQUIRED] staging runs the production code path; set to 'production' so prod-required validation actually runs here (that is the point of staging)
APP_NAME=Byblos-Staging
PORT=3000                           # backend listens here; nginx proxies /api -> backend:3000
BYBLOS_PROCESS_ROLE=all             # 'all' = API + workers in one process; use 'worker' for the split worker container

# --- Database -----------------------------------------------------------------
# Provide EITHER DATABASE_URL, OR all four DB_* parts (validateEnv accepts either).
DB_HOST=postgres                    # [REQUIRED] docker service name on the compose network
DB_PORT=5432
DB_USER=byblos_staging_user         # [REQUIRED]
DB_PASSWORD=change_me_staging_db_password   # [REQUIRED] use a staging-only password, NOT the production one
DB_NAME=byblos_staging              # [REQUIRED] MUST differ from the production database name
DB_SSL=false
# DATABASE_URL=postgres://user:pass@host:5432/byblos_staging   # alternative to the DB_* parts above

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379        # [OPTIONAL] app degrades to an in-memory rate-limit store if unreachable, but staging should mirror prod and run real Redis

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=change_me_staging_jwt_secret_min_32_chars_long_xxxxx          # [REQUIRED] must be >= 32 chars; use a staging-only value
JWT_REFRESH_SECRET=change_me_staging_jwt_refresh_secret_min_32_chars_xx  # [REQUIRED] must be >= 32 chars; distinct from JWT_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# --- URLs ---------------------------------------------------------------------
FRONTEND_URL=https://staging.bybloshq.space     # [REQUIRED] must start with http:// or https://
BACKEND_URL=https://staging.bybloshq.space      # [REQUIRED] must start with http:// or https://
ALLOWED_ORIGINS=https://staging.bybloshq.space  # [OPTIONAL] CORS allow-list

# --- Payments (Paystack) — TEST MODE on staging -------------------------------
PAYMENT_PROVIDER=paystack           # only 'paystack' is supported
PAYOUT_PROVIDER=paystack            # only 'paystack' is supported
PAYSTACK_SECRET_KEY=sk_test_your_staging_test_secret_key   # [REQUIRED-PROD] use TEST keys on staging, never live sk_live_
PAYSTACK_PUBLIC_KEY=pk_test_your_staging_test_public_key   # [REQUIRED-PROD] TEST key
PAYSTACK_BASE_URL=https://api.paystack.co                  # [REQUIRED-PROD] same base URL for test and live; the key prefix decides the mode
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220   # [REQUIRED-PROD] webhooks fail CLOSED if unset; these are Paystack's published source IPs
PAYSTACK_WEBHOOK_URL=https://staging.bybloshq.space/api/webhooks/paystack        # register this exact URL in the Paystack dashboard's TEST-mode webhook settings
PAYSTACK_PAYMENT_CALLBACK_URL=https://staging.bybloshq.space/api/webhooks/paystack   # [REQUIRED-PROD]
PAYSTACK_PAYOUT_CALLBACK_URL=https://staging.bybloshq.space/api/webhooks/paystack    # [REQUIRED-PROD]

# --- Email --------------------------------------------------------------------
# At least ONE email transport is required-in-prod: RESEND_API_KEY, EMAIL_HOST, or SMTP_HOST.
EMAIL_FROM_EMAIL=no-reply@staging.bybloshq.space   # [REQUIRED]
EMAIL_FROM_NAME=Byblos Staging
# RESEND_API_KEY=re_your_staging_key               # simplest transport; set this OR the SMTP block below
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# --- Media (Cloudinary) -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_staging_cloud_name   # [REQUIRED-PROD]
CLOUDINARY_API_KEY=your_staging_api_key         # [REQUIRED-PROD]
CLOUDINARY_API_SECRET=your_staging_api_secret   # [REQUIRED-PROD]

# --- Seed / operator accounts -------------------------------------------------
# [OPTIONAL for boot] The app boots fine without these; it only WARNS if they
# are unset. ADMIN_*/MARKETING_* are consumed by the standalone seed scripts
# that create those logins (scripts/seed-admin.js, scripts/seed-marketing-admin.js
# — each validates its own inputs); ADMIN_*/MARKETING_*/MZIGO_* all ALSO
# self-bootstrap their account on that account's first login (see
# AuthService.bootstrapPrivilegedAccountIfConfigured and
# LogisticsDashboardService.bootstrapMzigoAccountIfConfigured) — useful when
# there's no shell access to run the seed scripts directly. Set them so
# staging has working admin / marketing / logistics logins.
ADMIN_EMAIL=admin@staging.bybloshq.space              # used by scripts/seed-admin.js
ADMIN_PASSWORD=change_me_staging_admin_password
MARKETING_EMAIL=marketing@staging.bybloshq.space      # used by scripts/seed-marketing-admin.js
MARKETING_PASSWORD=change_me_staging_marketing_pw
MZIGO_EMAIL=mzigo@staging.bybloshq.space              # bootstraps the Mzigo Ego logistics login on first login
MZIGO_PASSWORD=change_me_staging_mzigo_password

# --- Observability / real-time alerting ---------------------------------------
# [OPTIONAL] When set, critical failures (uncaught exceptions, 5xx programming
# errors, fraud / amount-mismatch / self-referral events) are pushed to this
# incoming webhook in real time — in addition to being logged and persisted.
# Works with Slack, Google Chat, Mattermost (via `text`) and Discord (via
# `content`); paste any incoming-webhook URL. Leave unset to keep log-only
# behaviour (nothing is pushed). Secrets/PII in alert context are scrubbed
# before sending. See server/src/shared/utils/alerting.js.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_ENV_LABEL=staging   # [OPTIONAL] label shown in each alert so you can tell staging from prod at a glance

# --- Logistics tuning (optional; defaults live in logisticsQuote.service.js) --
# COURIER_WHATSAPP_NUMBER=2547XXXXXXXX
# DROPOFF_LOCATION=Dynamic Mall, Tom Mboya St, Nairobi | Shop SL 32
# LOGISTICS_HUB_LABEL=MZIGO EGO
# LOGISTICS_HUB_ADDRESS=Dynamic mall shop sl32
# LOGISTICS_HUB_LATITUDE=-1.2836
# LOGISTICS_HUB_LONGITUDE=36.8249
# LOGISTICS_RATE_KES_PER_KM=40
