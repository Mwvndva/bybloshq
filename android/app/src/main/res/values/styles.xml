<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/byblos_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/byblos_launch_background</item>
        <item name="android:navigationBarColor">@color/byblos_launch_background</item>
    </style>


    <!-- Launch theme: shown while the process starts and BridgeActivity.onCreate()
         runs. Uses a plain windowBackground splash drawable so no Compat SplashScreen
         window is created. Theme.SplashScreen was removed because it creates a
         blocking SplashScreen window that requires SplashScreen.installSplashScreen()
         to dismiss it — but BridgeActivity's WebView init blocks the main thread for
         7+ seconds, exceeding the system's 5-second top-resumed timeout, causing
         onPause/onStop before the WebView renders. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
